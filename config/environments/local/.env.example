# Copy to .env in this directory. The .env file is Git-ignored.
ROADSENSE_ENV=local
COMPOSE_PROJECT_NAME=roadsense-local

# Use an absolute host path. Future Compose files mount it read-only at
# /data/archives inside sensor-replay.
ROADSENSE_DATASET_ROOT=/absolute/path/to/road-sense/data/raw/archives
ROADSENSE_DATASET_CONTAINER_PATH=/data/archives
ROADSENSE_MVP_ARCHIVE="Bumpy Gravel - imu.tar"
ROADSENSE_MVP_MEMBER=imu/bosch_imu.csv

# Future local service-to-service names. These are not host endpoints.
MQTT_HOST=mqtt-broker
MQTT_PORT=8883
MQTT_USERNAME=roadsense-local
MQTT_PASSWORD=
MQTT_TLS_CA_FILE=/run/roadsense/mqtt/ca.crt
MQTT_RAW_TOPIC=roadsense/v1/imu/raw
MQTT_RUN_COMPLETE_TOPIC=roadsense/v1/imu/run-complete
MQTT_FEATURE_TOPIC=roadsense/v1/imu/features
MQTT_EVENT_TOPIC=roadsense/v1/events
PROCESSOR_MQTT_CLIENT_ID=roadsense-signal-processor-local
PROCESSOR_QUEUE_CAPACITY=1024
ANALYZER_MQTT_CLIENT_ID=roadsense-road-analyzer-local
ANALYZER_QUEUE_CAPACITY=1024
ANALYZER_VIBRATION_RMS_THRESHOLD_MG=100.0
ANALYZER_RULE_VERSION=roadsense-high-vibration-rms-v1-t100
ANALYZER_SESSION_REGISTRY_FILE=/app/session-registry.json
MQTT_CONNECT_TIMEOUT_SECONDS=10
MQTT_PUBLISH_TIMEOUT_SECONDS=10
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=roadsense
POSTGRES_USER=roadsense
POSTGRES_PASSWORD=
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_CONNECT_RETRIES=30
API_INTERNAL_URL=http://api:8000

# Future developer-facing mappings must retain the loopback bind address.
MQTT_BIND_ADDRESS=127.0.0.1
MQTT_HOST_PORT=8883
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=8000
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_HOST_PORT=8501
