# Copy to .env in this directory. The .env file is Git-ignored.
ROADSENSE_ENV=local
COMPOSE_PROJECT_NAME=roadsense-local

# Use an absolute host path. Future Compose files mount it read-only at
# /data/archives inside sensor-replay.
ROADSENSE_DATASET_ROOT=/absolute/path/to/road-sense/data/raw/archives
ROADSENSE_DATASET_CONTAINER_PATH=/data/archives
ROADSENSE_MVP_ARCHIVE="Bumpy Gravel - imu.tar"
ROADSENSE_MVP_MEMBER=imu/bosch_imu.csv

# Future local service-to-service names. These are not host endpoints.
MQTT_HOST=mqtt-broker
MQTT_PORT=1883
MQTT_USERNAME=roadsense-local
MQTT_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=roadsense
POSTGRES_USER=roadsense
POSTGRES_PASSWORD=
API_INTERNAL_URL=http://api:8000

# Future developer-facing mappings must retain the loopback bind address.
MQTT_BIND_ADDRESS=127.0.0.1
MQTT_HOST_PORT=1883
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=8000
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_HOST_PORT=8501
