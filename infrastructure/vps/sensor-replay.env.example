# ARCHIVED abandoned VPS plan; current Sensor Replay stays on the laptop.
# If restored by a future approved plan, copy to sensor-replay.env and chmod 600.
ROADSENSE_ENV=vps
ROADSENSE_DATASET_CONTAINER_PATH=/data/archives
ROADSENSE_MVP_ARCHIVE="Bumpy Gravel - imu.tar"
ROADSENSE_MVP_MEMBER=imu/bosch_imu.csv
SOURCE_ARCHIVE_SHA256=91d37ad4de7106d5038ed7bffe1e373db65e0f4771865da8975a216e76ed34f3
SESSION_ID=bumpy-gravel-20261019
SENSOR_ID=bosch-xdk-110
MAX_SAMPLES=1536
BATCH_SIZE=64
REPLAY_RATE=0
MAX_PAYLOAD_BYTES=131072
MQTT_HOST=REPLACE_APPROVED_MQTT_DNS
# CSC LoadBalancer Service external port; Routes cannot carry raw MQTT.
MQTT_PORT=30883
MQTT_USERNAME=REPLACE_USERNAME
MQTT_PASSWORD=REPLACE_SECRET_VALUE
MQTT_TLS_CA_FILE=/run/roadsense/mqtt/ca.crt
MQTT_TOPIC=roadsense/v1/imu/raw
MQTT_RUN_COMPLETE_TOPIC=roadsense/v1/imu/run-complete
MQTT_CONNECT_RETRIES=10
MQTT_CONNECT_TIMEOUT_SECONDS=10
