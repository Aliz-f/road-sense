# Copy to .env on the VPS; chmod 600; never commit.
# Compose interpolation only: this file is not injected into either container.
SENSOR_IMAGE=ghcr.io/REPLACE_OWNER/road-sense-sensor-replay@sha256:REPLACE_DIGEST
DASHBOARD_IMAGE=ghcr.io/REPLACE_OWNER/road-sense-dashboard@sha256:REPLACE_DIGEST
ROADSENSE_DATASET_ROOT=/srv/roadsense/archives
MQTT_CA_HOST_PATH=/srv/roadsense/certs/ca.crt
DASHBOARD_HOST_PORT=8501
