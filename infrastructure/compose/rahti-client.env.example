# Copy to rahti-client.env (Git-ignored), chmod 600, and fill only locally.
# Compose also reads dataset/provenance settings from the existing generated
# config/environments/local/.env.phase02 file.
RAHTI_MQTT_FORWARD_PORT=18883
RAHTI_API_FORWARD_PORT=18000
RAHTI_MQTT_USERNAME=roadsense-remote
RAHTI_MQTT_PASSWORD=REPLACE_WITH_PRIVATE_VALUE

# Point this at the protected Rahti secret directory containing Rahti's ca.crt.
MQTT_RUNTIME_DIR=/absolute/path/to/roadsense-rahti-secrets
