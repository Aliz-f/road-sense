    LM --> LP["Signal Processor"]
    LP -->|"features"| LM
    LM --> LA["Road Analyzer"]
    LA --> LDB[("PostgreSQL")]
    LDB --> LAPI["FastAPI"] --> LUI["Streamlit"] --> LB["Browser"]
  end

  subgraph LAPTOP_DEMO["LAPTOP — distributed demo clients"]
    DD["Private MUHOS CSV"] --> DF["Sensor Replay"]
    DUI["Streamlit"] --> DB["Browser"]
    MF["127.0.0.1:18883\noc port-forward"]
    AF["127.0.0.1:18000\noc port-forward"]
    DF -->|"authenticated MQTT/TLS"| MF
    AF -->|"private HTTP"| DUI
  end

  subgraph RAHTI["CSC RAHTI — OpenShift private backend"]
    RM["Mosquitto ClusterIP + PVC"] --> RP["Signal Processor + PVC"]
