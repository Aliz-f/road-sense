    RM --> RA["Road Analyzer"]
    RA --> RDB[("PostgreSQL + PVC")]
    RDB --> RAPI["FastAPI ClusterIP"]
  end

  MF -.->|"authenticated oc session"| RM
  RAPI -.->|"authenticated oc session"| AF
  LAPTOP_LOCAL -.->|"tested images + guarded oc deploy"| RAHTI
